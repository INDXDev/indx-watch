{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!schemas",
      "!**/*.html",
      "!examples/shop/store",
      "!**/.indx-watch/runs",
      "!**/.indx-watch/cache",
      "!**/*.md",
      "!examples/shop/.indx-watch",
      "!.indx-watch",
      "!.mcp.json",
      "!**/*.toml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "packages/bundle/src/**", "!packages/bundle/src/node/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "core and bundle are pure: use a port",
                  "node:fs/promises": "core and bundle are pure: use a port",
                  "aws4fetch": "vendor SDKs only inside store adapters",
                  "hono": "server only"
                }
              }
            }
          }
        }
      }
    }
  ]
}
