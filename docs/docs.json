{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "INDX Watch",
  "description": "File-first, agent-native test management: test cases, test data and results as typed files in your repository, with release readiness computed from them.",
  "colors": {
    "primary": "#2550c4",
    "light": "#8cadff",
    "dark": "#1d409e"
  },
  "navbar": {
    "links": [
      { "label": "Live demo", "href": "https://indx-watch-demo.i-248.workers.dev" },
      { "label": "Changelog", "href": "https://github.com/INDXDev/indx-watch/blob/main/CHANGELOG.md" }
    ],
    "primary": { "type": "github", "href": "https://github.com/INDXDev/indx-watch" }
  },
  "footer": {
    "socials": { "github": "https://github.com/INDXDev/indx-watch" }
  },
  "redirects": [
    { "source": "/README", "destination": "/" },
    { "source": "/adr/README", "destination": "/adr/0001-file-first-bundle" }
  ],
