{
  // Cloudflare Workers static assets: no Worker code, only the files of `next build` (out/).
  // Deploy: pnpm build && pnpm run deploy (README.md#deploy-to-cloudflare).
  "name": "indx-watch-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
