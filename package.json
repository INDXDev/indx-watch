{
  "name": "indx-watch-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "iw": "tsx packages/cli/src/bin.ts",
    "build": "pnpm -r --filter ./packages/web --filter ./packages/cli run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "bench:sync": "IW_BENCH=1 vitest run packages/sync/test/compact.test.ts -t 100,000",
    "schemas": "tsx packages/bundle/scripts/gen-schemas.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:example": "tsx packages/cli/src/bin.ts check --dir examples/shop/.indx-watch",
    "check:pure": "scripts/check-pure.sh",
    "check:report": "scripts/check-report.sh",
    "check:worker": "tsx scripts/check-worker.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm schemas --check && pnpm check:docs && pnpm check:pure && node scripts/loc.mjs && pnpm build && pnpm check:example && pnpm check:report && pnpm check:worker",
    "e2e": "playwright test -c e2e",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@indx-watch/playwright": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
