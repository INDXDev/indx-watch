{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "sha256",
    "size",
    "media_type"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/INDXDev/indx-watch/main/schemas/v1/blob-pointer.json",
  "title": "blob-pointer"
}
