{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ss_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "key": {
      "type": "string",
      "pattern": "^SS-[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "human",
        "ai",
        "import"
      ]
    },
    "approved_by": {
      "type": "string"
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "use": {
            "type": "string",
            "pattern": "^SS-[1-9][0-9]*$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "screenshot",
                "video",
                "trace",
                "log",
                "file"
              ]
            }
          },
          "i18n": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "instruction": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ]
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{12}$"
                }
              },
              "required": [
                "status",
                "source_hash"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "en",
          "ja"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "machine",
              "reviewed"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          }
        },
        "required": [
          "status",
          "source_hash"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "ai": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "model",
        "created_at"
      ],
      "additionalProperties": false
    },
    "x": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "key",
    "title",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/INDXDev/indx-watch/main/schemas/v1/shared-step.json",
  "title": "shared-step"
}
