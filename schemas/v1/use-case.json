{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^uc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "key": {
      "type": "string",
      "pattern": "^UC-[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "deprecated"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "human",
        "ai",
        "import"
      ]
    },
    "approved_by": {
      "type": "string"
    },
    "approved_version": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ac_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "key": {
            "type": "string",
            "pattern": "^AC-[1-9][0-9]*\\.[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "ready",
              "retired"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "human",
              "ai",
              "import"
            ]
          },
          "approved_by": {
            "type": "string"
          },
          "ai": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "skill": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "model",
              "created_at"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "i18n": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ]
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{12}$"
                }
              },
              "required": [
                "text",
                "status",
                "source_hash"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "key",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "en",
          "ja"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "machine",
              "reviewed"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          }
        },
        "required": [
          "status",
          "source_hash"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "ai": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "model",
        "created_at"
      ],
      "additionalProperties": false
    },
    "x": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "key",
    "title",
    "actor",
    "goal",
    "priority",
    "criteria"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/INDXDev/indx-watch/main/schemas/v1/use-case.json",
  "title": "use-case"
}
