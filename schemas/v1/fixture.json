{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fx_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "key": {
      "type": "string",
      "pattern": "^FX-[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "deprecated"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "human",
        "ai",
        "import"
      ]
    },
    "approved_by": {
      "type": "string"
    },
    "approved_version": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "dataset",
        "seed",
        "file",
        "account"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+$"
      }
    },
    "row_key": {
      "type": "string"
    },
    "hook": {
      "type": "string",
      "enum": [
        "seed",
        "reset"
      ]
    },
    "account": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "secret_ref": {
          "type": "string",
          "pattern": "^(env|cf|gh|op|aws-sm|gcp-sm|vault):[A-Za-z0-9_./-]+$"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "username",
        "secret_ref"
      ],
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "en",
          "ja"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "machine",
              "reviewed"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          }
        },
        "required": [
          "status",
          "source_hash"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "ai": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "model",
        "created_at"
      ],
      "additionalProperties": false
    },
    "x": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "key",
    "title",
    "kind"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/INDXDev/indx-watch/main/schemas/v1/fixture.json",
  "title": "fixture"
}
