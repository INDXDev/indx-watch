{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "key": {
      "type": "string",
      "pattern": "^TC-[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "deprecated"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "human",
        "ai",
        "import"
      ]
    },
    "approved_by": {
      "type": "string"
    },
    "approved_version": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "covers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[1-9][0-9]*\\.[1-9][0-9]*$"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "manual",
        "playwright",
        "agent",
        "hybrid"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "start": {
      "type": "string",
      "pattern": "^\\/"
    },
    "start_note": {
      "type": "string"
    },
    "preconditions": {
      "type": "string"
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^FX-[1-9][0-9]*$"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apply": {
            "type": "string",
            "enum": [
              "before_run"
            ]
          },
          "use": {
            "type": "string",
            "enum": [
              "download",
              "upload",
              "enter",
              "seeded"
            ]
          },
          "note": {
            "type": "string"
          },
          "i18n": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "note": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ]
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{12}$"
                }
              },
              "required": [
                "status",
                "source_hash"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "screenshot",
                "video",
                "trace",
                "log",
                "file"
              ]
            }
          },
          "i18n": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "instruction": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ]
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{12}$"
                }
              },
              "required": [
                "status",
                "source_hash"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "instruction",
          "expected"
        ],
        "additionalProperties": false
      }
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "assert",
              "visual",
              "llm",
              "human"
            ]
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "baseline": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "decision_policy": {
      "type": "object",
      "properties": {
        "llm_pass_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "llm_fail_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visual_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_human_for": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "en",
          "ja"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "preconditions": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "start_note": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "machine",
              "reviewed"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          }
        },
        "required": [
          "status",
          "source_hash"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "ai": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "model",
        "created_at"
      ],
      "additionalProperties": false
    },
    "x": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "key",
    "title",
    "covers",
    "mode",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/INDXDev/indx-watch/main/schemas/v1/test-case.json",
  "title": "test-case"
}
